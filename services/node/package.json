{
  "name": "predictive-autoscaling-node",
  "version": "1.0.0",
  "description": "Node.js (Fastify + TypeScript) backend stack for the predictive auto-scaling thesis. One image parameterized by SERVICE_NAME (user|product|order).",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
